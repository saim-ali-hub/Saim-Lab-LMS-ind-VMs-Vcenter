        TASK10_OK=0
        break
    fi
    done

    if [ "$TASK10_OK" -eq 1 ]; then
        pass "Task 10: matching .sh files copied successfully"
    else
        fail "Task 10: required .sh files are missing from exec-dir"
    fi

    # ============================================================
