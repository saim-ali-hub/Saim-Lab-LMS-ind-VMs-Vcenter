validate_lab212_tar_backup_management() {
    set +e
    set +u
    set +o pipefail

    echo "Checking Lab 212 - Tape Archive (TAR) & backup Management..."

    HOME_DIR="/home/$STUDENT_NAME"
    BASE="$HOME_DIR/search_lab"

    TOTAL_TASKS=10
    PASSED=0

    LAB_NAME="Lab 212 - Tape Archive (TAR) & backup Management"
    DATE=$(date "+%F %T")

    # ============================================================
    # HELPERS
    # ============================================================

    pass() {
        echo "<div class='validation-pass'>✓ $1 – Pass</div>"
        ((PASSED++))
    }

    fail() {
        echo "<div class='validation-fail'>✗ $1 – Fail</div>"
    }

    # ============================================================
    # PATHS
    # ============================================================

    APPLICATION="$BASE/application"
    CONFIGURATION="$BASE/configuration"
    LOGS="$BASE/logs"
    REPORTS="$BASE/reports"
    SCRIPTS="$BASE/scripts"

    BACKUP="$BASE/backup"
    ARCHIVE="$BASE/archive"
    TMP="$BASE/tmp"

    APPLICATION_TAR="$BACKUP/application_backup.tar"
    CONFIGURATION_TAR="$BACKUP/configuration_backup.tar.gz"
    LOGS_TAR="$BACKUP/logs_backup.tar.bz2"
    REPORTS_TAR="$BACKUP/reports_backup.tar.xz"

    RESTORE_APP="$TMP/restore_app"
    RESTORE_CONFIG="$TMP/restore_config"

    FINAL_REPORT1="$TMP/final_report1.txt"
    FINAL_REPORT2="$TMP/final_report2.txt"
    FINAL_ARCHIVE="$ARCHIVE/search_lab_backup.tar.gz"
    FINAL_RESTORE="$TMP/final_restore"

    # TASK 1 - CREATE APPLICATION TAR ARCHIVE
    TASK1_OK=1

    if [ ! -f "$APPLICATION_TAR" ]; then
        TASK1_OK=0
    fi

    if [ -f "$APPLICATION_TAR" ]; then

        # Verify valid tar archive
        if ! tar -tf "$APPLICATION_TAR" >/dev/null 2>&1; then
            TASK1_OK=0
        fi

        # Verify application directory exists in archive
        if ! tar -tf "$APPLICATION_TAR" 2>/dev/null |
            grep -Eq '(^|/)application(/|$)'; then
            TASK1_OK=0
        fi

        # Verify all application files are included
        if [ -d "$APPLICATION" ]; then

            while IFS= read -r FILE; do

                RELATIVE="${FILE#$BASE/}"

                if ! tar -tf "$APPLICATION_TAR" 2>/dev/null |
                    grep -Fxq "$RELATIVE"; then
                    TASK1_OK=0
                    break
                fi

            done < <(find "$APPLICATION" -type f 2>/dev/null)

        else
            TASK1_OK=0
        fi

    fi

    # Verify original application files still exist
    if [ ! -d "$APPLICATION" ]; then
        TASK1_OK=0
    fi

    if [ "$TASK1_OK" -eq 1 ]; then
        pass "Task 1: application tar archive created and verified successfully"
    else
        fail "Task 1: application tar archive is missing or incomplete"
    fi

    # TASK 2 - GZIP COMPRESSED CONFIGURATION ARCHIVE
    TASK2_OK=1

    if [ ! -f "$CONFIGURATION_TAR" ]; then
        TASK2_OK=0
    fi

    if [ -f "$CONFIGURATION_TAR" ]; then

        if ! gzip -t "$CONFIGURATION_TAR" >/dev/null 2>&1; then
            TASK2_OK=0
        fi

        if ! tar -tzf "$CONFIGURATION_TAR" >/dev/null 2>&1; then
            TASK2_OK=0
        fi

        if ! tar -tzf "$CONFIGURATION_TAR" 2>/dev/null |
            grep -Eq '(^|/)configuration(/|$)'; then
            TASK2_OK=0
        fi

        if [ -d "$CONFIGURATION" ]; then

            while IFS= read -r FILE; do

                RELATIVE="${FILE#$BASE/}"

                if ! tar -tzf "$CONFIGURATION_TAR" 2>/dev/null |
                    grep -Fxq "$RELATIVE"; then
                    TASK2_OK=0
                    break
                fi

            done < <(find "$CONFIGURATION" -type f 2>/dev/null)

        else
            TASK2_OK=0
        fi

    fi

    if [ "$TASK2_OK" -eq 1 ]; then
        pass "Task 2: gzip-compressed configuration archive created and verified"
    else
        fail "Task 2: gzip-compressed configuration archive is missing or incomplete"
    fi

    # TASK 3 - BZIP2 COMPRESSED LOGS ARCHIVE
    TASK3_OK=1

    if [ ! -f "$LOGS_TAR" ]; then
        TASK3_OK=0
    fi

    if [ -f "$LOGS_TAR" ]; then

        if ! bzip2 -t "$LOGS_TAR" >/dev/null 2>&1; then
            TASK3_OK=0
        fi

        if ! tar -tjf "$LOGS_TAR" >/dev/null 2>&1; then
            TASK3_OK=0
        fi

        if ! tar -tjf "$LOGS_TAR" 2>/dev/null |
            grep -Eq '(^|/)logs(/|$)'; then
            TASK3_OK=0
        fi

        if [ -d "$LOGS" ]; then

            while IFS= read -r FILE; do

                RELATIVE="${FILE#$BASE/}"

                if ! tar -tjf "$LOGS_TAR" 2>/dev/null |
                    grep -Fxq "$RELATIVE"; then
                    TASK3_OK=0
                    break
                fi

            done < <(find "$LOGS" -type f 2>/dev/null)

        else
            TASK3_OK=0
        fi

    fi

    if [ "$TASK3_OK" -eq 1 ]; then
        pass "Task 3: bzip2-compressed logs archive created and verified"
    else
        fail "Task 3: bzip2-compressed logs archive is missing or incomplete"
    fi

    # TASK 4 - XZ COMPRESSED REPORTS ARCHIVE
    TASK4_OK=1

    if [ ! -f "$REPORTS_TAR" ]; then
        TASK4_OK=0
    fi

    if [ -f "$REPORTS_TAR" ]; then

        if ! xz -t "$REPORTS_TAR" >/dev/null 2>&1; then
            TASK4_OK=0
        fi

        if ! tar -tJf "$REPORTS_TAR" >/dev/null 2>&1; then
            TASK4_OK=0
        fi

        if ! tar -tJf "$REPORTS_TAR" 2>/dev/null |
            grep -Eq '(^|/)reports(/|$)'; then
            TASK4_OK=0
        fi

        if [ -d "$REPORTS" ]; then

            while IFS= read -r FILE; do

                RELATIVE="${FILE#$BASE/}"

                if ! tar -tJf "$REPORTS_TAR" 2>/dev/null |
                    grep -Fxq "$RELATIVE"; then
                    TASK4_OK=0
                    break
                fi

            done < <(find "$REPORTS" -type f 2>/dev/null)

        else
            TASK4_OK=0
        fi

    fi

    if [ "$TASK4_OK" -eq 1 ]; then
        pass "Task 4: xz-compressed reports archive created and verified"
    else
        fail "Task 4: xz-compressed reports archive is missing or incomplete"
    fi

    # TASK 5 - EXTRACT APPLICATION ARCHIVE
    TASK5_OK=1
    ARCHIVE="$BASE/backup/application_backup.tar"
    RESTORE="$BASE/tmp/restore_app"

    [ -f "$ARCHIVE" ] || TASK5_OK=0
    [ -d "$RESTORE" ] || TASK5_OK=0

    if [ "$TASK5_OK" -eq 1 ]; then

    # Verify application directory was restored
    [ -d "$RESTORE/application" ] || TASK5_OK=0

    # Verify restored files match original files
    if [ "$TASK5_OK" -eq 1 ]; then
        diff -qr "$BASE/application" "$RESTORE/application" >/dev/null 2>&1 || TASK5_OK=0
    fi

    fi

    if [ "$TASK5_OK" -eq 1 ]; then
        pass "Task 5: application archive extracted and verified successfully"
    else
        fail "Task 5: application archive extraction or verification failed"
    fi

    # TASK 6 - EXTRACT CONFIGURATION ARCHIVE
    TASK6_OK=1

    if [ ! -d "$RESTORE_CONFIG" ]; then
        TASK6_OK=0
    fi

    if [ -d "$RESTORE_CONFIG" ]; then

        if [ ! -d "$RESTORE_CONFIG/configuration" ]; then
            TASK6_OK=0
        fi

        if [ -d "$CONFIGURATION" ] &&
           [ -d "$RESTORE_CONFIG/configuration" ]; then

            while IFS= read -r FILE; do

                RELATIVE="${FILE#$CONFIGURATION/}"
                RESTORED="$RESTORE_CONFIG/configuration/$RELATIVE"

                if [ ! -f "$RESTORED" ]; then
                    TASK6_OK=0
                    break
                fi

                if ! cmp -s "$FILE" "$RESTORED"; then
                    TASK6_OK=0
                    break
                fi

            done < <(find "$CONFIGURATION" -type f 2>/dev/null)

        else
            TASK6_OK=0
        fi

    fi

    if [ "$TASK6_OK" -eq 1 ]; then
        pass "Task 6: configuration archive extracted and files verified successfully"
    else
        fail "Task 6: configuration archive extraction or verification failed"
    fi


    # TASK 7 - FIND LOG FILES AND LONG LIST
    TASK7_OK=1
    OUTPUT="$BASE/tmp/final_report1.txt"

    [ -f "$OUTPUT" ] || TASK7_OK=0

    if [ "$TASK7_OK" -eq 1 ]; then
        grep -q "\.log" "$OUTPUT" || TASK7_OK=0
    fi

    if [ "$TASK7_OK" -eq 1 ]; then
        pass "Task 7: log files located and stored in final_report1.txt"
    else
        fail "Task 7: final_report1.txt is missing or log file output is missing"
    fi

    # TASK 8 - FIND .CONF FILES AND GREP DATABASE
    TASK8_OK=1
    OUTPUT="$BASE/tmp/final_report2.txt"

    [ -f "$OUTPUT" ] || TASK8_OK=0

    if [ "$TASK8_OK" -eq 1 ]; then
        grep -q "\.conf" "$OUTPUT" || TASK8_OK=0
    fi

    if [ "$TASK8_OK" -eq 1 ]; then
        pass "Task 8: configuration files containing DATABASE identified successfully"
    else
        fail "Task 8: final_report2.txt is missing or configuration output is missing"
    fi

    # TASK 9 - CREATE FINAL COMPRESSED ARCHIVE
    TASK9_OK=1

    if [ ! -f "$FINAL_ARCHIVE" ]; then
        TASK9_OK=0
    fi

    if [ -f "$FINAL_ARCHIVE" ]; then

        # Verify gzip archive
        if ! gzip -t "$FINAL_ARCHIVE" >/dev/null 2>&1; then
            TASK9_OK=0
        fi

        # Verify tar archive
        if ! tar -tzf "$FINAL_ARCHIVE" >/dev/null 2>&1; then
            TASK9_OK=0
        fi

        # Required directories
        for DIR in \
            application \
            configuration \
            logs \
            reports \
            scripts
        do

            if ! tar -tzf "$FINAL_ARCHIVE" 2>/dev/null |
                grep -Eq "^${DIR}(/|$)"; then
                TASK9_OK=0
            fi

        done

        # Verify all files from required directories
        for DIR in \
            application \
            configuration \
            logs \
            reports \
            scripts
        do

            SOURCE_DIR="$BASE/$DIR"

            if [ -d "$SOURCE_DIR" ]; then

                while IFS= read -r FILE; do

                    RELATIVE="${FILE#$BASE/}"

                    if ! tar -tzf "$FINAL_ARCHIVE" 2>/dev/null |
                        grep -Fxq "$RELATIVE"; then
                        TASK9_OK=0
                        break
                    fi

                done < <(find "$SOURCE_DIR" -type f 2>/dev/null)

            fi

        done

        # backup must NOT be included
        if tar -tzf "$FINAL_ARCHIVE" 2>/dev/null |
            grep -Eq '(^|/)backup(/|$)'; then
            TASK9_OK=0
        fi

        # archive must NOT be included
        if tar -tzf "$FINAL_ARCHIVE" 2>/dev/null |
            grep -Eq '(^|/)archive(/|$)'; then
            TASK9_OK=0
        fi

        # tmp must NOT be included
        if tar -tzf "$FINAL_ARCHIVE" 2>/dev/null |
            grep -Eq '(^|/)tmp(/|$)'; then
            TASK9_OK=0
        fi

    fi

    if [ "$TASK9_OK" -eq 1 ]; then
        pass "Task 9: final compressed archive created and verified successfully"
    else
        fail "Task 9: final archive is missing, incomplete, or contains excluded directories"
    fi

    # TASK 10 - EXTRACT FINAL ARCHIVE
    TASK10_OK=1

    if [ ! -d "$FINAL_RESTORE" ]; then
        TASK10_OK=0
    fi

    if [ -d "$FINAL_RESTORE" ]; then

        # Verify required directories were restored
        for DIR in \
            application \
            configuration \
            logs \
            reports \
            scripts
        do

            if [ ! -d "$FINAL_RESTORE/$DIR" ]; then
                TASK10_OK=0
            fi

        done

        # Verify files from each required directory
        for DIR in \
            application \
            configuration \
            logs \
            reports \
            scripts
        do

            SOURCE_DIR="$BASE/$DIR"

            if [ -d "$SOURCE_DIR" ]; then

                while IFS= read -r FILE; do

                    RELATIVE="${FILE#$BASE/}"
                    RESTORED="$FINAL_RESTORE/$RELATIVE"

                    if [ ! -f "$RESTORED" ]; then
                        TASK10_OK=0
                        break
                    fi

                    if ! cmp -s "$FILE" "$RESTORED"; then
                        TASK10_OK=0
                        break
                    fi

                done < <(find "$SOURCE_DIR" -type f 2>/dev/null)

            fi

        done

    fi

    if [ "$TASK10_OK" -eq 1 ]; then
        pass "Task 10: final archive extracted and restored files verified successfully"
    else
        fail "Task 10: final archive extraction or file verification failed"
    fi
    # ============================================================
    # SUMMARY
