validate_lab211_global_regular_expression() {
    set +e
    set +u
    set +o pipefail

    echo "Checking Lab 211 - Global Regular Expression (Grep)..."

    HOME_DIR="/home/$STUDENT_NAME"
    BASE="$HOME_DIR/search_lab"
    ARCHIVE="$BASE/archive"

    TOTAL_TASKS=20
    PASSED=0

    LAB_NAME="Lab 211 - Global Regular Expression (Grep)"
    DATE=$(date "+%F %T")

    pass() {
        echo "<div class='validation-pass'>✓ $1 – Pass</div>"
        ((PASSED++))
    }

    fail() {
        echo "<div class='validation-fail'>✗ $1 – Fail</div>"
    }

    GREP="$BASE/tmp/grep.txt"
    OPTION="$BASE/tmp/option.txt"
    RECURSIVE="$BASE/tmp/recursive.txt"
    REGEXP="$BASE/tmp/regexp.txt"

    # TASK 1 - OPERATOR
    if [ -f "$GREP" ] &&
       grep -Fqx "$(grep "operator" "$ARCHIVE/passwd")" "$GREP"
    then
        pass "Task 1: operator search completed successfully"
    else
        fail "Task 1: operator search failed"
    fi

    # TASK 2 - POLKITD
    if [ -f "$GREP" ] &&
       grep -Fqx "$(grep "polkitd" "$ARCHIVE/group")" "$GREP"
    then
        pass "Task 2: polkitd search completed successfully"
    else
        fail "Task 2: polkitd search failed"
    fi

    # TASK 3 - SHUTDOWN
    if [ -f "$GREP" ] &&
       grep -Fqx "$(grep "shutdown" "$ARCHIVE/passwd")" "$GREP"
    then
        pass "Task 3: shutdown search completed successfully"
    else
        fail "Task 3: shutdown search failed"
    fi

    # TASK 4 - MAIL
    if [ -f "$GREP" ] &&
       grep -Fqx "$(grep "mail" "$ARCHIVE/group")" "$GREP"
    then
        pass "Task 4: mail search completed successfully"
    else
        fail "Task 4: mail search failed"
    fi

    # TASK 5 - GREP -v SEARCH
    if [ -f "$GREP" ] &&
       grep -Fq "$(grep -v "search" "$ARCHIVE/resolv.conf" | head -n 1)" "$GREP"
    then
        pass "Task 5: grep -v search completed successfully"
    else
        fail "Task 5: grep -v search failed"
    fi

    # TASK 6 - GREP -n BASH
    if [ -f "$OPTION" ] &&
       grep -Fq "$(grep -n "bash" "$ARCHIVE/passwd" | head -n 1)" "$OPTION"
    then
        pass "Task 6: grep -n bash completed successfully"
    else
        fail "Task 6: grep -n bash failed"
    fi

    # TASK 7 - GREP -i MAIL
    if [ -f "$OPTION" ] &&
       grep -Fq "$(grep -i "MAIL" "$ARCHIVE/group" | head -n 1)" "$OPTION"
    then
        pass "Task 7: grep -i MAIL completed successfully"
    else
        fail "Task 7: grep -i MAIL failed"
    fi

    # TASK 8 - GREP -v NAMESERVER
    if [ -f "$OPTION" ] &&
       grep -Fq "$(grep -v "nameserver" "$ARCHIVE/resolv.conf" | head -n 1)" "$OPTION"
    then
        pass "Task 8: grep -v nameserver completed successfully"
    else
        fail "Task 8: grep -v nameserver failed"
    fi

    # TASK 9 - GREP -c NOLOGIN
    COUNT=$(grep -c "nologin" "$ARCHIVE/passwd" 2>/dev/null)

    if [ -f "$OPTION" ] &&
       grep -Fxq "$COUNT" "$OPTION"
    then
        pass "Task 9: grep -c nologin completed successfully"
    else
        fail "Task 9: grep -c nologin failed"
    fi

    # TASK 10 - GREP -i -n PERMIT
    if [ -f "$OPTION" ] &&
       grep -Fq "$(grep -i -n "permit" "$ARCHIVE/sshd_config" | head -n 1)" "$OPTION"
    then
        pass "Task 10: grep -i -n permit completed successfully"
    else
        fail "Task 10: grep -i -n permit failed"
    fi

    # TASK 11 - grep -l localhost
    TASK11_OK=1
    OUTPUT="$BASE/tmp/option.txt"

    [ -f "$OUTPUT" ] || TASK11_OK=0

    if [ "$TASK11_OK" -eq 1 ]; then
        grep -Eq '^archive/.*' "$OUTPUT" || TASK11_OK=0
    fi

    if [ "$TASK11_OK" -eq 1 ]; then
        pass "Task 11: grep -l localhost completed successfully"
    else
        fail "Task 11: grep -l localhost failed"
    fi

    # TASK 12 - Recursive grep Production
    TASK12_OK=1
    OUTPUT="$BASE/tmp/recursive.txt"

    [ -f "$OUTPUT" ] || TASK12_OK=0

    if [ "$TASK12_OK" -eq 1 ]; then
        grep -q "Production" "$OUTPUT" || TASK12_OK=0
        grep -Eq '^(application|configuration)/' "$OUTPUT" || TASK12_OK=0
    fi

    if [ "$TASK12_OK" -eq 1 ]; then
        pass "Task 12: recursive grep for Production completed successfully"
    else
        fail "Task 12: recursive grep for Production failed"
    fi

    # TASK 13 - Recursive grep customerdb
    TASK13_OK=1

    [ -f "$OUTPUT" ] || TASK13_OK=0

    if [ "$TASK13_OK" -eq 1 ]; then
        grep -q "customerdb" "$OUTPUT" || TASK13_OK=0
        grep -Eq '^(application|configuration)/' "$OUTPUT" || TASK13_OK=0
    fi

    if [ "$TASK13_OK" -eq 1 ]; then
        pass "Task 13: recursive grep for customerdb completed successfully"
    else
        fail "Task 13: recursive grep for customerdb failed"
    fi

    # TASK 14 - Recursive grep 8080
    TASK14_OK=1

    [ -f "$OUTPUT" ] || TASK14_OK=0

    if [ "$TASK14_OK" -eq 1 ]; then
        grep -q "8080" "$OUTPUT" || TASK14_OK=0
        grep -Eq '^(application|configuration)/' "$OUTPUT" || TASK14_OK=0
    fi

    if [ "$TASK14_OK" -eq 1 ]; then
        pass "Task 14: recursive grep for 8080 completed successfully"
    else
        fail "Task 14: recursive grep for 8080 failed"
    fi

    # TASK 15 - Recursive grep root
    TASK15_OK=1

    [ -f "$OUTPUT" ] || TASK15_OK=0

    if [ "$TASK15_OK" -eq 1 ]; then
        grep -q "root" "$OUTPUT" || TASK15_OK=0
        grep -q "^archive/" "$OUTPUT" || TASK15_OK=0
    fi

    if [ "$TASK15_OK" -eq 1 ]; then
       pass "Task 15: recursive grep for root completed successfully"
    else
       fail "Task 15: recursive grep for root failed"
    fi

    # TASK 16 - Recursive grep nameserver
    TASK16_OK=1

    [ -f "$OUTPUT" ] || TASK16_OK=0

    if [ "$TASK16_OK" -eq 1 ]; then
        grep -q "archive/" "$OUTPUT" || TASK16_OK=0
        grep -q "resolv.conf" "$OUTPUT" || TASK16_OK=0
    fi

    if [ "$TASK16_OK" -eq 1 ]; then
        pass "Task 16: recursive grep for nameserver completed successfully"
    else
        fail "Task 16: recursive grep for nameserver failed"
    fi

    # TASK 17 - EMPTY LINES
    if [ -f "$REGEXP" ] &&
       grep -Fq "$(grep -n '^$' "$ARCHIVE/sshd_config" | head -n 1)" "$REGEXP"
    then
        pass "Task 17: empty lines with line numbers completed successfully"
    else
        fail "Task 17: empty lines with line numbers failed"
    fi

    # TASK 18 - START WITH #
    if [ -f "$REGEXP" ] &&
       grep -Fq "$(grep '^#' "$ARCHIVE/sshd_config" | head -n 1)" "$REGEXP"
    then
        pass "Task 18: lines starting with # completed successfully"
    else
        fail "Task 18: lines starting with # failed"
    fi

    # TASK 19 - START WITH # WITH LINE NUMBERS
    if [ -f "$REGEXP" ] &&
       grep -Fq "$(grep -n '^#' "$ARCHIVE/sshd_config" | head -n 1)" "$REGEXP"
    then
        pass "Task 19: lines starting with # with line numbers completed successfully"
    else
        fail "Task 19: lines starting with # with line numbers failed"
    fi

    # TASK 20 - COUNT #
    COUNT=$(grep -c '^#' "$ARCHIVE/sshd_config" 2>/dev/null)

    if [ -f "$REGEXP" ] &&
       grep -Fxq "$COUNT" "$REGEXP"
    then
        pass "Task 20: count of lines starting with # completed successfully"
    else
        fail "Task 20: count of lines starting with # failed"
    fi

    # ============================================================
    # SUMMARY
    # ============================================================

    PERCENT=$((PASSED * 100 / TOTAL_TASKS))

    if [ "$PASSED" -eq "$TOTAL_TASKS" ]; then
        RESULT_CLASS="result-success"
        RESULT_ICON="✓"
        RESULT_TEXT="LAB PASSED"
    else
        RESULT_CLASS="result-failed"
        RESULT_ICON="✗"
        RESULT_TEXT="LAB NEEDS ATTENTION"
    fi

    # ============================================================
    # RESULT STYLES
    # ============================================================

    cat <<'HTML'
<style>
.validation-pass {
    margin:6px 0;
    padding:10px 14px;
    background:#DCFCE7;
    color:#166534;
    border-left:5px solid #22C55E;
    border-radius:6px;
    font-weight:600;
}

.validation-fail {
    margin:6px 0;
    padding:10px 14px;
    background:#FEE2E2;
    color:#991B1B;
    border-left:5px solid #EF4444;
    border-radius:6px;
    font-weight:600;
}

.lab-summary {
    margin-top:25px;
    padding:28px;
    border-radius:14px;
    text-align:center;
    background:#0f172a;
    border:2px solid #38bdf8;
    color:#fff;
}

.lab-summary-title {
    font-size:24px;
    font-weight:700;
    margin-bottom:20px;
    color:#38bdf8;
}

.lab-summary-info {
    text-align:left;
    max-width:650px;
    margin:0 auto 20px auto;
}

.lab-summary-row {
    padding:10px 0;
    border-bottom:1px solid #334155;
}

.lab-summary-label {
    font-weight:700;
    color:#94a3b8;
    display:inline-block;
    min-width:110px;
}

.result-percentage {
    margin-top:20px;
    font-size:42px;
    font-weight:800;
    color:#38bdf8;
}

.result-success {
    margin-top:20px;
    padding:15px;
    background:#166534;
    color:#dcfce7;
    border:2px solid #22c55e;
    border-radius:10px;
    font-size:21px;
    font-weight:700;
}

.result-failed {
    margin-top:20px;
    padding:15px;
    background:#991b1b;
    color:#fee2e2;
    border:2px solid #ef4444;
    border-radius:10px;
    font-size:21px;
    font-weight:700;
}
</style>
HTML

    # ============================================================
    # RESULT SUMMARY
    # ============================================================

    cat <<HTML
<div class="lab-summary">

<div class="lab-summary-title">LAB RESULT SUMMARY</div>

<div class="lab-summary-info">

<div class="lab-summary-row">
<span class="lab-summary-label">Student:</span>
<span>$STUDENT_NAME</span>
</div>

<div class="lab-summary-row">
<span class="lab-summary-label">Lab:</span>
<span>$LAB_NAME</span>
</div>

<div class="lab-summary-row">
<span class="lab-summary-label">Total Tasks:</span>
<span>$TOTAL_TASKS</span>
</div>

<div class="lab-summary-row">
<span class="lab-summary-label">Passed:</span>
<span>$PASSED</span>
</div>

</div>

<div class="result-percentage">$PERCENT%</div>

<div class="$RESULT_CLASS">
$RESULT_ICON $RESULT_TEXT
</div>

</div>
