validate_lab213_find_files() {
    set +e
    set +u
    set +o pipefail

    echo "Checking Lab 213 - Find Files and Directories in Linux Filesystem..."

    HOME_DIR="/home/$STUDENT_NAME"
    BASE="$HOME_DIR/search_lab"

    TOTAL_TASKS=10
    PASSED=0

    LAB_NAME="Lab 213 - Find Files and Directories in Linux Filesystem"
    DATE=$(date "+%F %T")

    # ============================================================
    # HELPERS
    # ============================================================

    pass() {
        echo "<div class='validation-pass'>✓ $1 – Pass</div>"
        ((PASSED++))
    }

    fail() {
        echo "<div class='validation-fail'>✗ $1 – Fail</div>"
    }


    # TASK 1 - SEARCH_LAB DIRECTORY
    TASK1_OK=1

    if [ ! -d "$BASE" ]; then
        TASK1_OK=0
    fi

    if [ -d "$BASE" ]; then
        OWNER=$(stat -c "%U" "$BASE" 2>/dev/null)

        if [ "$OWNER" != "$STUDENT_NAME" ]; then
            TASK1_OK=0
        fi
    fi

    if [ "$TASK1_OK" -eq 1 ]; then
        pass "Task 1: search_lab directory copied successfully and owned by the student"
    else
        fail "Task 1: search_lab directory is missing or ownership is incorrect"
    fi

    # TASK 2 - SEARCH BY FILE NAME
    TASK2_OK=1
    OUTPUT="$BASE/tmp/file-name.txt"

    [ -f "$OUTPUT" ] || TASK2_OK=0

    if [ -f "$OUTPUT" ]; then
        grep -q "app.conf" "$OUTPUT" || TASK2_OK=0
        grep -q "application.log" "$OUTPUT" || TASK2_OK=0
        grep -q "database.conf" "$OUTPUT" || TASK2_OK=0
    fi

    if [ "$TASK2_OK" -eq 1 ]; then
        pass "Task 2: find by file name completed successfully"
    else
        fail "Task 2: file-name.txt is missing or required file names are missing"
    fi

    # TASK 3 - SEARCH BY FILE TYPE
    TASK3_OK=1

    [ -f "$BASE/tmp/search-dir.txt" ] || TASK3_OK=0
    [ -f "$BASE/tmp/search-file.txt" ] || TASK3_OK=0

    if [ "$TASK3_OK" -eq 1 ]; then
        grep -q "$BASE" "$BASE/tmp/search-dir.txt" || \
            grep -q "\./" "$BASE/tmp/search-dir.txt" || TASK3_OK=0

        grep -q "$BASE" "$BASE/tmp/search-file.txt" || \
            grep -q "\./" "$BASE/tmp/search-file.txt" || TASK3_OK=0
    fi

    if [ "$TASK3_OK" -eq 1 ]; then
        pass "Task 3: find by file type completed successfully"
    else
        fail "Task 3: search-dir.txt or search-file.txt is missing or empty"
    fi

    # TASK 4 - SEARCH BY FILE EXTENSION
    TASK4_OK=1
    OUTPUT="$BASE/tmp/extension.txt"

    [ -f "$OUTPUT" ] || TASK4_OK=0

    if [ -f "$OUTPUT" ]; then
        grep -q "\.log" "$OUTPUT" || TASK4_OK=0
        grep -q "\.conf" "$OUTPUT" || TASK4_OK=0
        grep -q "\.properties" "$OUTPUT" || TASK4_OK=0
    fi

    if [ "$TASK4_OK" -eq 1 ]; then
        pass "Task 4: find by file extension completed successfully"
    else
        fail "Task 4: extension.txt is missing or required extensions are missing"
    fi

    # TASK 5 - SEARCH BY FILE SIZE
    TASK5_OK=1

    [ -f "$BASE/tmp/small-size.txt" ] || TASK5_OK=0
    [ -f "$BASE/tmp/large-size.txt" ] || TASK5_OK=0

    if [ "$TASK5_OK" -eq 1 ]; then
        pass "Task 5: find by file size completed successfully"
    else
        fail "Task 5: small-size.txt or large-size.txt is missing"
    fi

    # TASK 6 - SEARCH BY MODIFICATION TIME
    TASK6_OK=1

    [ -f "$BASE/tmp/time-day.txt" ] || TASK6_OK=0
    [ -f "$BASE/tmp/time-min.txt" ] || TASK6_OK=0

    if [ ! -f "$BASE/tmp/time-day.txt" ] && [ ! -f "/tmp/time-day.txt" ]; then
        TASK6_OK=0
    fi

    if [ ! -f "$BASE/tmp/time-min.txt" ] && [ ! -f "/tmp/time-min.txt" ]; then
        TASK6_OK=0
    fi

    if [ "$TASK6_OK" -eq 1 ]; then
        pass "Task 6: find by modification time completed successfully"
    else
        fail "Task 6: time-day.txt or time-min.txt is missing"
    fi

    # TASK 7 - SEARCH BY PERMISSIONS
    TASK7_OK=1
    OUTPUT="$BASE/tmp/permission.txt"

    [ -f "$OUTPUT" ] || TASK7_OK=0

    if [ -f "$OUTPUT" ]; then

        # Check that permission search produced long-list output
        grep -Eq "^-.*[x].*[x].*" "$OUTPUT" || TASK7_OK=0

        # Check for SGID indicator
        find "$BASE/scripts" -type f -perm -2000 2>/dev/null |
            grep -q . || true
    fi

    if [ "$TASK7_OK" -eq 1 ]; then
        pass "Task 7: find by permissions completed successfully"
    else
        fail "Task 7: permission.txt is missing or required permission output is missing"
    fi

    # TASK 8 - FIND WITH -EXEC
    TASK8_OK=1
    OUTPUT="$BASE/tmp/exec1.txt"

    [ -f "$OUTPUT" ] || TASK8_OK=0

    if [ -f "$OUTPUT" ]; then
        # ls -l output should contain .log files
        grep -q "\.log" "$OUTPUT" || TASK8_OK=0

        # Long listing normally contains permissions and ownership
        grep -Eq "^-|^l" "$OUTPUT" || TASK8_OK=0
    fi

    if [ "$TASK8_OK" -eq 1 ]; then
        pass "Task 8: find with -exec completed successfully"
    else
        fail "Task 8: exec.txt is missing or .log long-list output is missing"
    fi

    # TASK 9 - MULTIPLE CONDITIONS
    TASK9_OK=1
    OUTPUT="$BASE/tmp/exec2.txt"

