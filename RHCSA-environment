#!/bin/bash

set -euo pipefail

# ============================================================
# LINOOP STUDENT VM CONFIGURATION
# Oracle Linux / RHEL 9
# ============================================================

CLIENT_NETWORK="10.90.0.0/16"

if [ "$EUID" -ne 0 ]; then
    echo "ERROR: This script must be run as root."
    exit 1
fi

echo
echo "=========================================="
echo " LINOOP Setup Starts now ......."
echo "=========================================="

# ------------------------------------------------------------
# 1. STUDENT PASSWORDLESS SUDO
# ------------------------------------------------------------

echo
echo "Enter your VPN/LDAP username:"
read -rp "VPN/LDAP Username: " VPN_USER

if [[ ! "$VPN_USER" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    echo "ERROR: Invalid or empty username."
    exit 1
fi

if ! id "$VPN_USER" >/dev/null 2>&1; then
    echo "ERROR: User $VPN_USER does not exist."
    exit 1
fi

# Remove student from wheel
gpasswd -d "$VPN_USER" wheel 2>/dev/null || true

SUDO_FILE="/etc/sudoers.d/linoop-student"

printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$VPN_USER" > "$SUDO_FILE"
chmod 440 "$SUDO_FILE"

if visudo -cf "$SUDO_FILE" >/dev/null 2>&1; then
    echo "Passwordless sudo configured."
else
    echo "ERROR: Invalid sudoers configuration."
    rm -f "$SUDO_FILE"
    exit 1
fi

# ------------------------------------------------------------
# 2. INSTALL REQUIRED PACKAGES
# ------------------------------------------------------------

echo
echo "Installing required packages..."

dnf install -y httpd nfs-utils chrony firewalld

# ------------------------------------------------------------
# 3. CONFIGURE FIREWALLD
# ------------------------------------------------------------

echo
echo "Starting Firewalld..."

systemctl enable --now firewalld

# Identify the zone used by the student network interface
NET_INTERFACE=$(ip -o route get 10.90.0.1 |
    awk '{for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}')

ZONE=""

if [ -n "$NET_INTERFACE" ]; then
    ZONE=$(firewall-cmd --get-zone-of-interface="$NET_INTERFACE" 2>/dev/null || true)
fi

if [ -z "$ZONE" ] || [ "$ZONE" = "no zone" ]; then
    ZONE=$(firewall-cmd --get-default-zone)
fi

echo "Using firewall zone: $ZONE"

# HTTP - TCP 80
firewall-cmd --permanent --zone="$ZONE" \
    --add-rich-rule="rule family=ipv4 source address=$CLIENT_NETWORK service name=http accept"

# NFSv4 - TCP 2049
firewall-cmd --permanent --zone="$ZONE" \
    --add-rich-rule="rule family=ipv4 source address=$CLIENT_NETWORK port port=2049 protocol=tcp accept"

# Chrony NTP - UDP 123
firewall-cmd --permanent --zone="$ZONE" \
    --add-rich-rule="rule family=ipv4 source address=$CLIENT_NETWORK port port=123 protocol=udp accept"

# ------------------------------------------------------------
# 4. CONFIGURE APACHE HTTPD
# ------------------------------------------------------------

echo
echo "Configuring Apache HTTPD..."

# Remove existing Apache installation if present
if rpm -q httpd >/dev/null 2>&1; then
    systemctl stop httpd 2>/dev/null || true
    dnf remove -y httpd
fi

# Reinstall Apache
dnf install -y httpd

# Create empty index.html
mkdir -p /var/www/html
: > /var/www/html/index.html

chmod 644 /var/www/html/index.html
chown root:root /var/www/html/index.html

systemctl enable --now httpd

echo "Apache configured successfully."

# ------------------------------------------------------------
# 5. CONFIGURE NFS SERVER
# ------------------------------------------------------------

echo
echo "Configuring NFS Server..."

# Create NFS base directory
mkdir -p /remoteusers
chmod 755 /remoteusers

# Configure NFSv4 only
mkdir -p /etc/nfs.conf.d

cat > /etc/nfs.conf.d/linoop.conf <<EOF
[nfsd]
vers3=n
vers4=y
EOF

# Configure NFS export
EXPORT_FILE="/etc/exports"

# Remove previous LINOOP export entry, if any
sed -i '\|^[[:space:]]*/remoteusers[[:space:]]|d' "$EXPORT_FILE"

# NFSv4 pseudo-root export
cat >> "$EXPORT_FILE" <<EOF

# LINOOP NFS EXPORT
/remoteusers $CLIENT_NETWORK(rw,sync,root_squash,no_subtree_check,fsid=0)
EOF

# Start NFS server
systemctl enable --now nfs-server

# Apply exports
exportfs -rav

echo "NFS Server configured successfully."

# ------------------------------------------------------------
# 6. CREATE NFS USERS
# ------------------------------------------------------------

echo
echo "Creating NFS users..."

create_nfs_user() {

    USERNAME="$1"
    USER_UID="$2"
    USER_HOME="/remoteusers/$USERNAME"

    EXISTING_UID_USER=$(getent passwd "$USER_UID" | cut -d: -f1 || true)

    if [ -n "$EXISTING_UID_USER" ] &&
       [ "$EXISTING_UID_USER" != "$USERNAME" ]; then

        echo "ERROR: UID $USER_UID already belongs to $EXISTING_UID_USER."
        return 1
    fi

    if id "$USERNAME" >/dev/null 2>&1; then

        CURRENT_UID=$(id -u "$USERNAME")

        if [ "$CURRENT_UID" -ne "$USER_UID" ]; then
            echo "ERROR: $USERNAME has unexpected UID $CURRENT_UID."
            return 1
        fi

        # Ensure correct home directory
        usermod -d "$USER_HOME" "$USERNAME"

        echo "$USERNAME already exists."

    else

        useradd -u "$USER_UID" \
                -U \
                -d "$USER_HOME" \
                -M \
                -s /bin/bash \
                "$USERNAME"

        echo "Created $USERNAME with UID $USER_UID."

    fi

    mkdir -p "$USER_HOME"

    PRIMARY_GROUP=$(id -gn "$USERNAME")

    chown "$USERNAME:$PRIMARY_GROUP" "$USER_HOME"
    chmod 700 "$USER_HOME"
}

create_nfs_user user1 4001
create_nfs_user user2 4002
create_nfs_user user3 4003

echo "NFS users configured successfully."

# ------------------------------------------------------------
# 7. CONFIGURE CHRONY NTP SERVER
# ------------------------------------------------------------

echo
echo "Configuring Chrony..."

CHRONY_CONF="/etc/chrony.conf"

# Add LINOOP configuration only once
if ! grep -Fq "# LINOOP NTP SERVER CONFIGURATION" "$CHRONY_CONF"; then

    cat >> "$CHRONY_CONF" <<EOF

# LINOOP NTP SERVER CONFIGURATION
allow $CLIENT_NETWORK

# Provide local time when no upstream source is available
local stratum 10

EOF

fi

systemctl enable --now chronyd
systemctl restart chronyd

echo "Chrony configured successfully."

# ------------------------------------------------------------
# 8. RELOAD FIREWALL
# ------------------------------------------------------------

echo
echo "Applying firewall rules..."

firewall-cmd --reload

# ------------------------------------------------------------
# 9. FINAL SUMMARY
# ------------------------------------------------------------

echo
echo "=========================================="
echo " LINOOP CONFIGURATION SUMMARY"
echo "=========================================="

echo
echo "Apache HTTPD:"
systemctl is-active httpd

echo
echo "NFS Server:"
systemctl is-active nfs-server

echo
echo "Chrony:"
systemctl is-active chronyd

echo
echo "NFS Users:"
id user1
id user2
id user3

echo
echo "NFS Exports:"
exportfs -v

echo
echo "Chrony Sources:"
chronyc sources -v

echo
echo "Firewall Rules:"
firewall-cmd --zone="$ZONE" --list-all

echo
echo "=========================================="
echo " LINOOP Setup Completed Successfully."
echo "=========================================="
echo

exit 0

