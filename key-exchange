#!/bin/bash

set -e

VALIDATOR_KEY='ssh-rsa  validator@platform.linoop.local'

echo
echo "=========================================="
echo "LINOOP Setup Starts now ......."
echo "=========================================="
echo

read -p "Enter your VPN/ldap username: " USER_NAME
USER_NAME=$(echo "$USER_NAME" | xargs)

if [[ ! "$USER_NAME" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    echo "Error: Invalid username."
    exit 1
fi

read -p "Enter your machine IP address: " MACHINE_IPV4
MACHINE_IPV4=$(echo "$MACHINE_IPV4" | xargs)

if [[ ! "$MACHINE_IPV4" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    echo "Error: Invalid IP address."
    exit 1
fi

REMOTE="$USER_NAME@$MACHINE_IPV4"

echo
echo "Connecting to $REMOTE..."
echo "Enter your STUDENT VM password when prompted."
echo

ssh \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    "$REMOTE" \
    "mkdir -p ~/.ssh &&
     chmod 700 ~/.ssh &&
     touch ~/.ssh/authorized_keys &&
     chmod 600 ~/.ssh/authorized_keys &&
     grep -Fqx '$VALIDATOR_KEY' ~/.ssh/authorized_keys ||
     echo '$VALIDATOR_KEY' >> ~/.ssh/authorized_keys"

echo
echo "=========================================="
echo " LINOOP Set completed successfully."
echo "=========================================="
echo
echo

exit 0
